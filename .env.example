# Printer settings are normally written to config/printer.env by `./print.sh setup`.
# Set them here only to override that file.
# PRINTER_URI=ipp://192.168.1.40:631/ipp/print
# PRINTER_MODEL=everywhere
# PRINTER_OPTIONS=media=A4 sides=two-sided-long-edge
# PRINT_TIMEOUT_SECONDS=300

# KSeF token with the InvoiceRead permission, and your NIP (10 digits)
KSEF_TOKEN=
KSEF_NIP=
# prod (default), demo or test
# KSEF_ENV=prod
# Seconds to wait between print attempts (3 attempts after the first by default)
# RETRY_DELAYS_SECONDS=10,30,90

# ntfy notifications (optional)
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=
